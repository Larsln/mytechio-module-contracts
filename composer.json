{
    "name": "mytechio/module-contracts",
    "description": "Contracts (interfaces, DTOs, fakes) between the MyTechIO Admin core and its modules",
    "type": "library",
    "license": "proprietary",
    "keywords": [
        "mytechio",
        "contracts",
        "interfaces",
        "dto"
    ],
    "authors": [
        {
            "name": "MyTechIO AG"
        }
    ],
    "require": {
        "php": "^8.4"
    },
    "require-dev": {
        "pestphp/pest": "^4.0",
        "laravel/pint": "^1.18"
    },
    "autoload": {
        "psr-4": {
            "MyTechIO\\Contracts\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "MyTechIO\\Contracts\\Tests\\": "tests/"
        }
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true,
    "scripts": {
        "test": "vendor/bin/pest --compact",
        "lint": "vendor/bin/pint"
    }
}
